GIVEBUTTER_CAMPAIGN_URL=https://givebutter.com/beauty-forward
# TODO: Add Roadie credentials once integration is approved.
ROADIE_API_KEY=your-roadie-api-key
ROADIE_CLIENT_ID=your-roadie-client-id
# HubSpot Account Service Key. Mint at:
# Development -> Keys -> Service keys -> Create service key.
# Scopes required: crm.objects.contacts.read, crm.objects.contacts.write
HUBSPOT_SERVICE_KEY=your-hubspot-service-key
# Minimum donation (USD) required to schedule a courier pickup.
# Production should be 15. Lower it (e.g. 1) for local/staging testing of the gate.
PICKUP_DONATION_MIN_USD=15
# Givebutter API key for server-to-server transaction verification.
# Mint at https://givebutter.com/dashboard/integrations.
GIVEBUTTER_API_KEY=your-givebutter-api-key
# Resend API key for transactional emails (donation-issue notification).
# TODO: stubbed; a follow-up PR will wire actual sends. See ResendEmailService.
RESEND_API_KEY=your-resend-api-key
# Dev escape: when 'true', the verifyContributionAndDispatch trigger auto-verifies every
# pickup without calling Givebutter. Use ONLY in dev to exercise the dispatch path
# without a real donation. NEVER set in production.
SKIP_GIVEBUTTER_VERIFICATION=false
# Window (in minutes) the trigger scans backward for a matching donor transaction.
# 30 is generous; tighten if false-positive matches become a concern.
GIVEBUTTER_DONATION_LOOKBACK_MINUTES=30
