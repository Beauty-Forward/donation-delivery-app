# =============================================================================
# Two files in play. Firebase Functions Gen2 deploys .env (and .env.<project>)
# but treats .env.local as local-only. Use the right one for each var:
#
#   functions/.env        — deployed to Cloud Functions (sandbox creds, config)
#   functions/.env.local  — NEVER deployed (emulator hosts, dev escape hatches)
#
# Both are gitignored. Copy this file to .env to get started.
# =============================================================================

# ----------------------------------------------------------------------------
# Roadie courier dispatch. Credentials from https://developer.roadie.com.
# Deployed: yes. The trigger reads ROADIE_API_KEY at first dispatch — if absent,
# falls back to MockRoadieCourierProvider so dev without keys is harmless.
# ----------------------------------------------------------------------------
ROADIE_API_KEY=
ROADIE_API_BASE_URL=https://connect-sandbox.roadie.com/v1
# Warehouse contact passed to Roadie as the delivery recipient. Phone is
# required by Roadie; leave empty in dev and Roadie will 400 on real calls.
WAREHOUSE_CONTACT_NAME=Beauty Forward Warehouse
WAREHOUSE_CONTACT_PHONE=

# ----------------------------------------------------------------------------
# Givebutter (donation verification + checkout campaign URL).
# Deployed: yes.
# ----------------------------------------------------------------------------
GIVEBUTTER_CAMPAIGN_URL=https://givebutter.com/beauty-forward
# Mint at https://givebutter.com/dashboard/integrations.
GIVEBUTTER_API_KEY=your-givebutter-api-key
# Window (minutes) the trigger scans backward for a matching donor transaction.
GIVEBUTTER_DONATION_LOOKBACK_MINUTES=30

# ----------------------------------------------------------------------------
# Pickup gate. Deployed: yes. Production should be 15; lower in staging.
# ----------------------------------------------------------------------------
PICKUP_DONATION_MIN_USD=15

# ----------------------------------------------------------------------------
# HubSpot CRM upsert. Deployed: yes.
# Mint at Development -> Keys -> Service keys.
# Scopes: crm.objects.contacts.read, crm.objects.contacts.write
# ----------------------------------------------------------------------------
HUBSPOT_SERVICE_KEY=your-hubspot-service-key

# ----------------------------------------------------------------------------
# Resend transactional email. Deployed: yes (stubbed pending follow-up PR).
# ----------------------------------------------------------------------------
RESEND_API_KEY=your-resend-api-key

# =============================================================================
# The lines below belong in functions/.env.local, NOT functions/.env. They are
# emulator-only and would break the deployed function if shipped to Cloud Run.
# Firebase recognizes .env.local as local-only and excludes it from deploys.
# =============================================================================

# Points firebase-admin at the local Firestore emulator. The Gen2 emulator
# does not reliably propagate this var to the worker process, so we set it
# explicitly. Never set in prod.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Dev escape: when 'true', the verifyContributionAndDispatch trigger auto-
# verifies every pickup without calling Givebutter. Lets us exercise the
# dispatch path locally without paying through the live widget each iteration.
# NEVER set in production.
# SKIP_GIVEBUTTER_VERIFICATION=false
