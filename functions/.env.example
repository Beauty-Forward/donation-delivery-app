# =============================================================================
# Copy this to .env to get started
# =============================================================================

# Roadie API Key (production) is a firebase secret, does not live in .env
# The sandbox key for local dev lives in .env.local
ROADIE_API_BASE_URL=https://connect.roadie.com/v1

WAREHOUSE_CONTACT_NAME=Beauty Forward Warehouse
WAREHOUSE_CONTACT_PHONE=

# Minimum donation (USD) required to schedule a courier pickup.
PICKUP_DONATION_MIN_USD=15

# Givebutter API key for server-to-server transaction verification.
GIVEBUTTER_API_KEY=your-givebutter-key
GIVEBUTTER_CAMPAIGN_URL=https://givebutter.com/beauty-forward

# Givebutter webhook signing secret (production) is a firebase secret, does not live
# in .env. Get it from the Givebutter dashboard (View the webhook) and set it with:
#   firebase functions:secrets:set GIVEBUTTER_WEBHOOK_SIGNATURE
# For local dev it lives in .env.local (see below).

# Resend API key for transactional emails.
RESEND_API_KEY=your-resend-key
RESEND_FROM_EMAIL=Beauty Forward <confirmation@updates.beauty-forward.org>

# =============================================================================
# Copy the lines below to .env.local (not .env) to set up local testing.
# These are never deployed (Firebase excludes .env.local) and gitignored.
# Values here will override .env when running the emulator
# =============================================================================

# Roadie sandbox credentials for local dispatch. Override .env's prod values so
# the emulator never hits the production Roadie endpoint.
# ROADIE_API_KEY=your-roadie-sandbox-key
# ROADIE_API_BASE_URL=https://connect-sandbox.roadie.com/v1

# Dev escape: auto-verify every pickup without calling Givebutter, so the
# dispatch path can be exercised locally without paying through the live widget.
# SKIP_GIVEBUTTER_VERIFICATION=false

# Givebutter webhook signing secret. Any value works locally — it just has to match
# the `Signature` header you send on your test curls to handleGivebutterWebhook.
# GIVEBUTTER_WEBHOOK_SIGNATURE=your-local-webhook-secret
